{
  "name": "myfaveTT - Local Audio Downloader",
  "version": "9.9.9",
  "description": "Backup TikTok liked and followed audios locally.",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html",
    "default_title": "myfaveTT Local"
  },
  "background": {
    "service_worker": "b.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "s.js"
      ],
      "css": [
        "style.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "resources": [
        "popup.html"
      ]
    }
  ],
  "icons": {
    "256": "icon-256.png"
  }
}